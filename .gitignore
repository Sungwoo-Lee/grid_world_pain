# Skill eval workspaces — iteration outputs are transient
.claude/skills/*-workspace/
.claude/worktrees/

# Code-side wiki (graphify artefacts — large, per-machine, regenerated on demand)
# graphify writes to <scanned_path>/graphify-out/, so the pattern must match
# at any depth (e.g. src/graphify-out/, not just repo-root graphify-out/).
**/graphify-out/

docs/.obsidian/